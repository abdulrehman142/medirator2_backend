# Medirator 2.0 — Backend

# LLM provider: gemini (default) | grok
LLM_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional alias: GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Alternatives: gemini-pro-latest, gemini-flash-latest, gemini-2.5-pro

# Optional Grok (xAI) if LLM_PROVIDER=grok
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Google OAuth (same client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# JWT session
JWT_SECRET=change-me-medirator-dev-secret
JWT_EXPIRE_HOURS=24

# Comma-separated frontend origins for production
CORS_ORIGINS=https://medirator2.netlify.app

COOKIE_CROSS_SITE=true
