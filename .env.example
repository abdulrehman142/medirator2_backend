# Medirator 2.0 — Backend

# Grok (xAI) — get a key at https://console.x.ai/
GROK_API_KEY=
# Optional alias also accepted: XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Google OAuth (same client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# JWT session
JWT_SECRET=change-me-medirator-dev-secret
JWT_EXPIRE_HOURS=24

# Comma-separated frontend origins for production
CORS_ORIGINS=https://medirator2.netlify.app

# Role assignment by email (comma-separated) — unused; all users are "user"
ADMIN_EMAILS=
DOCTOR_EMAILS=
